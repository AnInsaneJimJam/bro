# Application
# Local development defaults. For the hosted Railway web service, use:
# NEXT_PUBLIC_APP_URL=https://web-production-d7f4c.up.railway.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bro
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/bro
# Railway containers use /app/config/certs/supabase-prod-ca-2021.crt.
DATABASE_SSL_CA_PATH=./config/certs/supabase-prod-ca-2021.crt
# Keep the per-request pool small for Supabase's session pooler.
DATABASE_POOL_MAX=4
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Supabase Auth and private Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ORIGINALS_BUCKET=bro-originals
SUPABASE_AUDIO_BUCKET=bro-audio
SUPABASE_RENDERS_BUCKET=bro-renders

# 32-byte base64 key; rotate by incrementing the version
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
OAUTH_STATE_SECRET=
# Preferred OpenRouter-compatible text provider for niche, opportunities, scripts, comments, and chat
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_SCRIPT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Bro
# Optional legacy text provider
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_SCRIPT_MODEL=gemini-flash-latest
GEMINI_COMMAND_TRANSCRIPTION_MODEL=gemini-flash-latest
# Optional fallback and current timestamped/audio transcription provider
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_SCRIPT_MODEL=gpt-5.6-luna
OPENAI_COMMAND_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_CAPTION_TRANSCRIPTION_MODEL=whisper-1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Railway: https://web-production-d7f4c.up.railway.app/api/oauth/youtube/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/youtube.force-ssl
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Railway: https://web-production-d7f4c.up.railway.app/api/oauth/instagram/callback
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/oauth/instagram/callback
INSTAGRAM_API_VERSION=v24.0
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_comments
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:3000/api/oauth/reddit/callback
REDDIT_USER_AGENT=web:bro-mvp:0.1 (by /u/yourname)
REDDIT_INTEGRATION_ENABLED=false

WORKER_CONCURRENCY=4
WORKER_RETRY_LIMIT=5
PUBLISH_STALE_AFTER_SECONDS=1800
PUBLISH_RECONCILE_INTERVAL_SECONDS=300
COMMENT_REFRESH_CRON=17 */6 * * *
# Supabase Free projects cap individual Storage objects at 50 MB.
MAX_UPLOAD_BYTES=52428800
MAX_VIDEO_DURATION_SECONDS=60
SENTRY_DSN=
