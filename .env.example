# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bro
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/bro

# Supabase Auth and private Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ORIGINALS_BUCKET=bro-originals
SUPABASE_AUDIO_BUCKET=bro-audio
SUPABASE_RENDERS_BUCKET=bro-renders

# 32-byte base64 key; rotate by incrementing the version
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
OAUTH_STATE_SECRET=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_SCRIPT_MODEL=gpt-5.6-luna
OPENAI_COMMAND_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_CAPTION_TRANSCRIPTION_MODEL=whisper-1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/oauth/instagram/callback
META_API_VERSION=v24.0
META_SCOPES=instagram_basic,instagram_content_publish,instagram_manage_comments
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:3000/api/oauth/reddit/callback
REDDIT_USER_AGENT=web:bro-mvp:0.1 (by /u/yourname)
REDDIT_INTEGRATION_ENABLED=false

WORKER_CONCURRENCY=4
WORKER_RETRY_LIMIT=5
COMMENT_REFRESH_CRON=17 */6 * * *
MAX_UPLOAD_BYTES=536870912
MAX_VIDEO_DURATION_SECONDS=60
SENTRY_DSN=
